<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <title>程式設計教學展示系統</title>
  
  <!-- Google Apps Script 伺服器端資料直出注入 (0 毫秒秒開) -->
  <script>
    window.__INITIAL_SERVER_DATA__ = <?!= typeof serverInitialData !== 'undefined' ? serverInitialData : 'null' ?>;
  </script>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
